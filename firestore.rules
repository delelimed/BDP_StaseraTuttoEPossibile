rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // L'app usa SOLO le collezioni "teams" (squadre) e "games" (giochi).
    // Tutto il resto è negato per default.
    //
    // In MODALITÀ EVENTO la scrittura è aperta perché non c'è login: va bene
    // su un progetto privato usato solo la sera dello spettacolo.
    //
    // PRIMA di renderlo pubblico, sostituisci `if true` con:
    //   allow read: if true;
    //   allow write: if request.auth != null;
    match /teams/{teamId} {
      allow read, write: if true;
    }

    match /games/{gameId} {
      allow read, write: if true;
    }

    // Default deny: nessun accesso a qualunque altra collezione.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
